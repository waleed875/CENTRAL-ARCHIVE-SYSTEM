# Docker Compose reads this file after you copy it to .env.
# These values are for local development only. Replace every password before
# sharing the environment or exposing a port beyond localhost.
POSTGRES_DB=central_archive
POSTGRES_USER=archive_user
POSTGRES_PASSWORD=archive_password
POSTGRES_PORT=5434

DB_URL=jdbc:postgresql://localhost:5433/central_archive
DB_USERNAME=postgres
DB_PASSWORD=admin

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=archive-files

# Base64-encoded 32-byte development key. Generate a unique value for any
# shared environment (for example: openssl rand -base64 32).
JWT_SECRET=bG9jYWwtZGV2ZWxvcG1lbnQtand0LXNlY3JldC0zMi1ieXRlISE=
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# The application creates this account only when its username does not exist.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeThisLocalAdminPassword123!
BOOTSTRAP_ADMIN_EMAIL=admin@central-archive.local

# The legacy database is optional and migration stays disabled by default.
LEGACY_DB_URL=jdbc:postgresql://localhost:5433/ARC2
LEGACY_DB_USERNAME=archive_user
LEGACY_DB_PASSWORD=archive_password
LEGACY_MIGRATION_ENABLED=false
LEGACY_MIGRATION_SCHEDULE_ENABLED=false
# Must match an existing core.confidentiality_levels.code before file migration.
LEGACY_MIGRATION_DEFAULT_CONFIDENTIALITY_CODE=
