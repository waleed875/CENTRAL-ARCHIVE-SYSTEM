                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const data = json && json.data ? json.data : json;",
                  "pm.test('Package operation summary present', () => data && data.packageId && data.status);",
                  "pm.test('Import operations and project stats present', () => Array.isArray(data.importOperations) && data.projectStats);"
                ]
