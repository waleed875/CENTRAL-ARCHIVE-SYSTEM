{
  "info": {
    "name": "Central Archive - 04 Import & Migration",
    "_postman_id": "import-migration-collection-0004",
    "description": "Offline package import/export and controlled legacy PostgreSQL migration endpoints.\n\nBase URL: {{baseUrl}} (default http://localhost:8080)\n\nRun Setup > Login first. Branch packages are uploaded as a real .pkg file using the package_file multipart field, verified, then explicitly imported. Actor identity is taken from the authenticated JWT. Public import-operation mutation/detail endpoints are not part of the current API. Legacy migration currently supports only the configured PostgreSQL staging datasource.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
