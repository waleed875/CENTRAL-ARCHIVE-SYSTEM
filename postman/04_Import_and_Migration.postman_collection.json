          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "receivedBy",
                  "value": "system",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/packages/receive?receivedBy=system",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "packages", "receive"],
              "query": [
                { "key": "receivedBy", "value": "system", "disabled": true }
              ]
            },
            "description": "multipart/form-data. Select the manifest JSON file in the `file` field. Statuses: RECEIVED, VERIFIED, IMPORTED, FAILED, DUPLICATE. Stores the new id into `{{packageId}}` (if present in the response)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "const u = j => j && j.data && typeof j.data === 'object' ? j.data : j;",
                  "const d = u(pm.response.json());",
                  "if (d && d.id) pm.collectionVariables.set('packageId', d.id);"
                ]
              }
            }
          ],
          "response": []
        },
