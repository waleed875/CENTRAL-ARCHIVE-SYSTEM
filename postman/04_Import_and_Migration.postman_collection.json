              "raw": "{{baseUrl}}/api/v1/packages?searchTerm=&status=&sourceOrganizationId=&page=1&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "packages"],
              "query": [
                { "key": "searchTerm", "value": "", "disabled": true },
                { "key": "status", "value": "", "disabled": true },
                { "key": "sourceOrganizationId", "value": "", "disabled": true },
                { "key": "page", "value": "1" },
                { "key": "size", "value": "20" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200', () => pm.response.to.have.status(200));"]
