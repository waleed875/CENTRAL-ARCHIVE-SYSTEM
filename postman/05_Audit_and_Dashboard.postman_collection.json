{
  "info": {
    "name": "Central Archive - 05 Audit & Dashboard",
    "_postman_id": "audit-dashboard-collection-0005",
    "description": "Audit log querying and dashboard statistics endpoints.\n\nBase URL: {{baseUrl}} (default http://localhost:8080)\n\n## First step\nRun **Setup > Login** once. It stores the token into `{{token}}` automatically. Bearer auth is configured at collection level.\n\n## Audit logs\nFilter by `userId`, `action`, `entityType`, `entityId`, and a `startDate`/`endDate` range (ISO-8601 datetime, e.g. 2026-01-01T00:00:00). Pagination is 1-based (page, size).\n\n## Dashboard\n`/stats` returns aggregate counts; `/activity` returns the most recent actions limited by `limit`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://w0x89x36-8080.euw.devtunnels.ms", "type": "string" },
    { "key": "username", "value": "admin", "type": "string" },
    { "key": "password", "value": "admin123", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "auditLogId", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Login (required)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const data = json && json.data ? json.data : json;",
                  "if (data && data.token) pm.collectionVariables.set('token', data.token);",
                  "if (data && data.refreshToken) pm.collectionVariables.set('refreshToken', data.refreshToken);"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Audit Logs",
      "item": [
        {
          "name": "Search Audit Logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/audit-logs?userId=&action=&entityType=&entityId=&startDate=&endDate=&page=1&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "audit-logs"],
              "query": [
                { "key": "userId", "value": "", "disabled": true },
                { "key": "action", "value": "", "disabled": true },
                { "key": "entityType", "value": "", "disabled": true },
                { "key": "entityId", "value": "", "disabled": true },
                { "key": "startDate", "value": "", "disabled": true },
                { "key": "endDate", "value": "", "disabled": true },
                { "key": "page", "value": "1" },
                { "key": "size", "value": "20" }
              ]
            },
            "description": "startDate / endDate are ISO-8601 datetime, e.g. 2026-01-01T00:00:00. Warning: this endpoint currently returns 500 (server bug - data type of parameter). See summary."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get Audit Log By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/audit-logs/{{auditLogId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "audit-logs", "{{auditLogId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get Entity History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/audit-logs/entity/{{entityType}}/{{entityId}}?page=1&size=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "audit-logs", "entity", "{{entityType}}", "{{entityId}}"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "size", "value": "50" }
              ]
            },
            "description": "entityType is a string (e.g. PROJECT), entityId is the record UUID. Returns the change history of that entity."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/dashboard/stats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "dashboard", "stats"]
            },
            "description": "Aggregate counts (projects, files, organizations, users, packages, etc.)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get Recent Activity",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/dashboard/activity?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "dashboard", "activity"],
              "query": [
                { "key": "limit", "value": "20" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ]
}
