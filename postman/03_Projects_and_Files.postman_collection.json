          "name": "Upload File (multipart)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "metadata",
                  "value": "{\n  \"categoryId\": \"{{fileCategoryId}}\",\n  \"typeId\": \"{{fileTypeId}}\",\n  \"confidentialityLevelId\": null\n}",
                  "type": "text",
                  "contentType": "application/json"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/projects/{{projectId}}/files/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "projects",
                "{{projectId}}",
                "files",
                "upload"
              ]
            },
